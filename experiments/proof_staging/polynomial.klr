;; User-level specializers. Coefficients and code builders are early values;
;; xs and x remain residual. No host compiler edits are needed to add a builder.
(def expanded-polynomial
  (fn [a b c x]
    (code (+ (esc (lift a))
             (+ (* (esc x) (esc (lift b)))
                (* (* (esc x) (esc x)) (esc (lift c))))))))

(def horner-polynomial
  (fn [a b c x]
    (code (+ (esc (lift a))
             (* (esc x) (+ (esc (lift b)) (* (esc x) (esc (lift c)))))))))

;; Context composition: either numeric builder fits either stream builder.
(def mapped-sum
  (fn [polynomial a b c]
    (code (fn [xs]
            (reduce + 0
              (map (fn [x] (esc (polynomial a b c (code x)))) xs))))))

(def folded-sum
  (fn [polynomial a b c]
    (code (fn [xs]
            (reduce (fn [acc x]
                      (+ acc (esc (polynomial a b c (code x)))))
                    0 xs)))))

;; Alternative composition: these are proposals, not trusted certificates.
(def polynomial-proposals
  (fn [a b c]
    {:source (mapped-sum expanded-polynomial a b c)
     :numeric (mapped-sum horner-polynomial a b c)
     :stream (folded-sum expanded-polynomial a b c)
     :both (folded-sum horner-polynomial a b c)}))
