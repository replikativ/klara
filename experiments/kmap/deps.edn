{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}}
 :aliases
 {:test  {:extra-paths ["test"]
          :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}}
  :nrepl {:extra-paths ["test" "bench"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"} criterium/criterium {:mvn/version "0.4.6"}
                       org.clojure/test.check {:mvn/version "1.1.1"}}
          :main-opts ["-m" "nrepl.cmdline" "--port" "47123"]}
  :bench {:extra-paths ["bench" "test"]
          :extra-deps {criterium/criterium {:mvn/version "0.4.6"}
                       org.clojure/test.check {:mvn/version "1.1.1"}}
          :jvm-opts ["-Xmx8g" "-XX:+UseParallelGC"]}}}
