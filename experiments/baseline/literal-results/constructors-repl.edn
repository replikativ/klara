 :source
 (fn
  [n]
  (let
   [rows
    (loop
     [i 0 rows []]
     (if
      (< i n)
      (recur (inc i) (conj rows {:bucket (rem i 16), :value (* i i)}))
      rows))]
   (loop
    [i 0 totals {}]
    (if
     (< i (count rows))
     (let
      [row (nth rows i) bucket (get row :bucket)]
      (recur
       (inc i)
       (assoc
        totals
        bucket
        (+ (get totals bucket 0) (get row :value)))))
     totals)))),
 :batch 20,
 :java "25.0.1+8-LTS-jvmci-b01",
 :explicit-source
 (fn
  [n]
  (let
   [rows
    (loop
     [i 0 rows []]
     (if
      (< i n)
      (recur
       (inc i)
       (conj rows (hash-map :bucket (rem i 16) :value (* i i))))
      rows))]
   (loop
    [i 0 totals {}]
    (if
     (< i (count rows))
     (let
      [row (nth rows i) bucket (get row :bucket)]
      (recur
       (inc i)
       (assoc
        totals
        bucket
        (+ (get totals bucket 0) (get row :value)))))
     totals)))),
