 :source
 (fn
  [n bias limit]
  (let
   [step
    (fn
     [acc i]
     (assoc (assoc acc 0 (+ (nth acc 0) i)) 1 (+ (nth acc 1) bias)))]
   (let
    [acc
     (loop
      [i 0 acc [0 0]]
      (if (< i n) (recur (inc i) (step acc i)) acc))]
    (< (+ (nth acc 0) (nth acc 1)) limit)))),
