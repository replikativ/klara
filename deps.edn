{:paths ["src"]
 ;; ansatz is the proof kernel S3's fusion certificates are checked by. Pinned to the
 ;; version wandler is tested against, so the differential test runs both on one kernel.
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.replikativ/ansatz {:mvn/version "0.2.115"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; differential oracle for S3 (klara.fusion-test); never required by src
                      io.github.replikativ/wandler {:local/root "../wandler"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
;; S5: differential test of the ansatz spec (spec/) against T0. Separate
  ;; because it elaborates the spec on the local ansatz checkout (~20 s).
  :spec-diff {:extra-paths ["test-spec" "spec/src" "spec/test"]
              :override-deps {org.replikativ/ansatz {:local/root "../ansatz"}}
              :extra-deps {io.github.cognitect-labs/test-runner
                           {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
              :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
              :exec-fn cognitect.test-runner.api/test
              :exec-args {:dirs ["test-spec"]}}
  :repl {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
         :main-opts ["-m" "klara.repl"]}
  :nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                       io.github.replikativ/wandler {:local/root "../wandler"}}
          :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
          :main-opts ["-m" "nrepl.cmdline"]}}}
