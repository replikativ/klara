{:paths ["src"]
 ;; ansatz checks fusion certificates and the restricted proof models.
 ;; Keep the proof cohort pinned; sibling projects are optional aliases below.
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.replikativ/ansatz {:mvn/version "0.2.115"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Optional sibling-project oracle, separate from the standalone suite.
  :test-integration {:extra-paths ["test" "test-integration"]
                     :extra-deps {io.github.replikativ/wandler {:local/root "../wandler"}
                                  io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                     :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
                     :main-opts ["-m" "cognitect.test-runner" "-d" "test-integration"]
                     :exec-fn cognitect.test-runner.api/test
                     :exec-args {:dirs ["test-integration"]}}
  :verify {:extra-paths ["test" "experiments" "experiments/proof_staging"]
           :jvm-opts ["-Xmx1g" "-Xss16m"]
           :main-opts ["-m" "consolidation.run"]}
  ;; S5 differential spec/T0 run currently uses the local ansatz checkout.
  :spec-diff {:extra-paths ["test-spec" "spec/src" "spec/test"]
              :override-deps {org.replikativ/ansatz {:local/root "../ansatz"}}
              :extra-deps {io.github.cognitect-labs/test-runner
                           {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
              :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
              :exec-fn cognitect.test-runner.api/test
              :exec-args {:dirs ["test-spec"]}}
  :repl {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
         :main-opts ["-m" "klara.repl"]}
  :nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}
          :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]
          :main-opts ["-m" "nrepl.cmdline"]}
  ;; Clay notebooks in notebooks/ (render with scicloj.clay.v2.api/make!)
  :notebook {:extra-paths ["notebooks"]
             :extra-deps {org.scicloj/clay {:mvn/version "2.0.13"}
                          org.scicloj/kindly {:mvn/version "4-beta23"}}
             :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xss16m"]}}}
