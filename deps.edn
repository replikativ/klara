{:paths ["src" "lib"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}}
 :aliases
 {;; clojure -M:klara run FILE | repl
  :klara {:jvm-opts ["-Xss16m"]
          :main-opts ["-m" "klara.host.main"]}
  :examples {:extra-paths ["examples"]}
  :test {:extra-paths ["test" "examples" "spec" "spec/formal/src"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["-Xss16m" "-Xmx512m" "-XX:SoftRefLRUPolicyMSPerMB=0"]
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; The formal semantics (spec/formal) is checked by ansatz. To work against
  ;; a local checkout: -Sdeps '{:deps {org.replikativ/ansatz {:local/root "../ansatz"}}}'
  :formal {:extra-paths ["spec/formal/src" "spec/formal/test"]
           :extra-deps {org.replikativ/ansatz {:mvn/version "0.2.579"}}
           :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  ;; clojure -M:formal:test-formal  checks the formal semantics and runs the
  ;; differential tests (KLARA_DIFF_SEEDS sets the number of generated programs)
  :test-formal {:extra-paths ["spec/formal/test" "spec"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                :jvm-opts ["-Xss16m" "-Xmx1g"]
                :main-opts ["-m" "cognitect.test-runner" "-d" "spec/formal/test"]}
  ;; clojure -M:bench  compares Klara, compiled Klara, SCI and Clojure
  :bench {:extra-paths ["bench"]
          :extra-deps {org.babashka/sci {:mvn/version "0.10.49"}}
          :jvm-opts ["-Xss16m" "-Xmx1g"]
          :main-opts ["-m" "klara.bench"]}
  ;; clojure -M:awfy  Are We Fast Yet? benchmarks: node, Clojure, Klara (design/07-performance.md)
  :awfy {:extra-paths ["bench"]
         :extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
         :jvm-opts ["-Xss16m" "-Xmx2g"]
         :main-opts ["-m" "klara.awfy"]}
  :dev {:extra-paths ["test" "examples" "spec" "bench" "spec/formal/src"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                     org.babashka/sci {:mvn/version "0.10.49"}
                     io.github.cognitect-labs/test-runner
                     {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
        :jvm-opts ["-Xss16m" "-Xmx1g"]}}}
